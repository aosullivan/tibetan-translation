# Secrets / env
.env
.env.*
!.env.example

# OCR language data (downloaded, not tracked)
tessdata-tib/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
myenv/
.venv/
venv/

# Editors / OS
.DS_Store
.clj-kondo/
.lsp/
.vscode/
.cursor/
.kiro/

# --- Translation artifacts (inputs, outputs, intermediates) ---

# Source PDFs / scanned pechas
*.pdf

# Wylie / transliteration intermediate outputs
*.wylie.txt
*.phonetic.txt

# Translation outputs
translation*.md
translation*.txt
tibetan_output.md
tibetan_translation.txt
tibetan_wylie.txt
tibetan_phonetic.txt
output.txt
*.translation.md

# Per-run input corpora (kept out of VCS; use fixtures for tests)
input.txt
saras*.txt
phakmo-sadhana.txt

# Corpora: ignore the contents, but keep the catalogue READMEs in version control
tibetan-texts/*
!tibetan-texts/README.md
tibetan_translations/*
!tibetan_translations/README.md

# Quarantined during tidy-up; delete when you've reviewed it
_to_delete/

# Progress / resume state
progress*.json
*.json.bak

# Logs
*.log
*.log.bak

# Caches
tibetan_processor_cache.json

# Keep test fixtures even though they match patterns above
!tests/fixtures/
!tests/fixtures/**

# Machine-local Claude tool permissions (skills are tracked)
.claude/settings.local.json
